{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	header -Server

	# Before the host check so the container healthcheck works on 127.0.0.1.
	handle /healthz {
		respond "ok" 200
	}

	# Blocks DNS rebinding: only serve hostnames this deployment names.
	@foreign_host not host {$SITE_HOSTS}
	handle @foreign_host {
		respond "Forbidden" 403
	}

	handle_path /api/* {
		reverse_proxy budget-server:9447
	}

	handle {
		reverse_proxy web:8080
	}
}
